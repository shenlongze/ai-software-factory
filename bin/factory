#!/usr/bin/env python3
"""bin/factory — AI Software Factory 统一 CLI 入口（项目内, 零配置）。

薄包装: 定位项目 .venv 解释器 → os.execv 切为新 CLI `apps.cli.main:main`。
用户零配置 —— 不要求懂 PYTHONPATH/npm: `./bin/factory status` 即可。

用法:
    ./bin/factory status
    ./bin/factory conversation list
    ./bin/factory run --project <目录> --objective "..."
    ./bin/factory <任意新 CLI 命令>

说明: 与已安装的 `.venv/bin/factory` 同源（都是 apps.cli.main）；
      本包装用于**仓库内直接调用**（不依赖 pip 安装）。

★ 2026-09-15 改写: 原包装切的是老 CLI
  （factory-console.cli_factory.main, 并把 _pending_migration 挂到 PYTHONPATH）——
  老区已整体删除 ⇒ 原包装必然 Traceback。现直连新 CLI, 不再需要任何路径拼接。
"""
from __future__ import annotations

import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
VENV_PY = ROOT / ".venv" / "bin" / "python"

if not VENV_PY.is_file():
    print(f"错误: 未找到虚拟环境解释器: {VENV_PY}", file=sys.stderr)
    print("请先安装依赖:", file=sys.stderr)
    print(f"  python3 -m venv {ROOT / '.venv'}", file=sys.stderr)
    print(f"  {ROOT / '.venv' / 'bin' / 'pip'} install -e '.[dev]'", file=sys.stderr)
    sys.exit(1)

# src/ + 仓库根（apps/ 在根下）—— 新地基的唯一两个路径, 无老区残留
os.environ["PYTHONPATH"] = os.pathsep.join(
    [str(ROOT), str(ROOT / "src"), os.environ.get("PYTHONPATH", "")]
).rstrip(os.pathsep)

_BOOT = (
    "import sys;"
    "sys.argv[0]='factory';"
    "from apps.cli.main import main;"   # ★ 新 CLI（老 CLI 已删除）
    "sys.exit(main())"
)
os.execv(str(VENV_PY), [str(VENV_PY), "-c", _BOOT, *sys.argv[1:]])
