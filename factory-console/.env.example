# AI Factory 配置示例 (S10-007 阶段一) — 复制本文件为 .env 后按需修改
#
# 加载优先级 (高 → 低, 逐 key 合并):
#   1. 进程环境变量 (export LLM_PROVIDER=... / uvicorn 启动前设置)
#   2. 项目 .env (本文件所在目录 factory-console/.env)
#   3. 用户级 ~/.factory/config.json  ({"llm": {...}, "data_dir": "...", "port": N})
#   4. 默认值 (config.py PROVIDER_DEFAULTS 映射表)
#
# 支持 provider: deepseek | openai | anthropic | ollama (本地模型)

# --- LLM Provider -----------------------------------------------------------
# 选择模型供应商 (默认 deepseek; 不写死 — 多 Provider 映射见 config.py)
LLM_PROVIDER=deepseek

# 模型名 (留空 = 使用 provider 默认映射:
#   deepseek → deepseek-v4-pro | openai → gpt-4o |
#   anthropic → claude-sonnet-4-20250514 | ollama → qwen2.5:14b)
LLM_MODEL=

# API 端点 (留空 = provider 默认:
#   deepseek → https://api.deepseek.com/v1/chat/completions
#   openai   → https://api.openai.com/v1/chat/completions
#   anthropic→ https://api.anthropic.com/v1/messages
#   本地 Ollama → http://127.0.0.1:11434/v1/chat/completions)
LLM_BASE_URL=

# API key — 两种写法:
#   1. 直接写值:  LLM_API_KEY=sk-xxxxxxxx
#   2. 引用环境变量: LLM_API_KEY=env:DEEPSEEK_API_KEY  (env:VAR 先查进程环境,
#      再查本 .env 文件的 VAR 行; 缺 VAR → 视为未配置, 诚实失败不臆造)
# key 进程内注入目标: deepseek/openai → OPENAI_API_KEY (OpenAI 兼容端点);
# anthropic → ANTHROPIC_API_KEY; ollama → 无 key (本地不校验)。
# 未配 LLM_API_KEY 时兜底: provider 专属环境变量 (DEEPSEEK_API_KEY /
# ANTHROPIC_API_KEY) → OPENAI_API_KEY (历史开发环境注入目标, 向后兼容)。
LLM_API_KEY=env:DEEPSEEK_API_KEY

# --- 数据与端口 --------------------------------------------------------------
# 数据目录 (默认 ~/.factory; 含 org/ 项目数据 + workflow_runs/ + chat.json)
DATA_DIR=~/.factory

# 后端端口 (默认 8011)
PORT=8011

# 前端端口 (默认 5180; vite dev)
FRONTEND_PORT=5180

# --- 用户级配置示例 (~/.factory/config.json, 优先级低于 .env) -----------------
# {
#   "llm": {
#     "provider": "deepseek",
#     "model": "deepseek-v4-pro",
#     "base_url": "https://api.deepseek.com/v1/chat/completions",
#     "api_key": "env:DEEPSEEK_API_KEY"
#   },
#   "data_dir": "~/.factory",
#   "port": 8011,
#   "frontend_port": 5180
# }
